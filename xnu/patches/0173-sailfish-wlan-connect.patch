+static void
+wl_put_mac(uint32_t *w, const uint8_t *m)
+{
+	w[0] = m[0] | m[1] << 8 | m[2] << 16 | (uint32_t)m[3] << 24;
+	w[1] = m[4] | m[5] << 8;
+}
+
+/* Start a WMI command with one fixed-param TLV of len bytes; returns its value (zeroed). */
+static uint32_t *
+wl_wmi_begin(uint32_t cmd, uint32_t tag, uint32_t len)
+{
+	uint32_t *w = (uint32_t *)wl_htc_tx_payload(&ce3);
+	bzero(w, 512);
+	*w++ = cmd;
+	return wl_tlv(w, tag, len);
+}
