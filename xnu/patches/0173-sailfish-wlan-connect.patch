+static uint64_t
+wl_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000;
+}
+
+static bool
+wl_noisy(uint32_t ev)
+{
+	return ev != WMI_MGMT_RX_EVTID && ev != 0x1d011u && ev != 0x4002u;    /* not beacons, fw debug log, chan info */
+}
+
+/* Wait for WMI event id; other events are printed (except the frequent ones). */
+static bool
+wl_wmi_event(uint32_t id, uint32_t ms)
+{
+	for (uint64_t end = wl_ms() + ms; wl_ms() < end;) {
+		if (wl_htc_poll(10) == wl_wmi_ep && wl_msg_len >= 4) {
+			uint32_t ev = le32(wl_msg) & 0xffffffu;
+			if (ev == id) {
+				return true;
+			}
+			if (wl_noisy(ev)) {
+				printf("SAILFISH WLAN: WMI event %#x (%u bytes)\n", ev, wl_msg_len);
+			}
+		}
+	}
+	return false;
+}
+
+/* Wait for a management frame of type fc from the BSS to us. */
+static const uint8_t *
+wl_wait_mgmt(uint8_t fc, uint32_t ms, uint32_t *flen)
+{
+	for (uint64_t end = wl_ms() + ms; wl_ms() < end;) {
+		if (wl_htc_poll(10) != wl_wmi_ep || wl_msg_len < 8) {
+			continue;
+		}
+		uint32_t ev = le32(wl_msg) & 0xffffffu;
+		if (ev != WMI_MGMT_RX_EVTID) {
+			if (wl_noisy(ev)) {
+				printf("SAILFISH WLAN: WMI event %#x (%u bytes)\n", ev, wl_msg_len);
+			}
+			continue;
+		}
+		const uint8_t *fr = wl_mgmt_frame(flen);
+		if (fr && fr[0] == fc && memcmp(fr + 4, wl_mac, 6) == 0 && memcmp(fr + 10, wl_bss.bssid, 6) == 0) {
+			return fr;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * HTT TX_FRM (ath10k_htt_tx_32): the frame goes to D_TXF, the descriptor and
+ * its first bytes (prefetch for the classifier) on CE 4. Management frames
+ * (type MGMT, tid 17) are fetched whole from frags_paddr; data frames
+ * (native wifi, non-QoS tid 16) through a fragment list. Completion: HTT
+ * TX_COMPL_IND with the msdu id (wl_txc_id).
+ */
+static uint16_t wl_tx_id;
+
+static bool
+wl_htt_tx(const uint8_t *fr, uint32_t len, bool mgmt)
+{
+	uint8_t *f = (uint8_t *)(wl_dma + D_TXF), *p = wl_htc_tx_payload(&ce4);
+	volatile uint32_t *frag = (volatile uint32_t *)(wl_dma + D_TXFRAG);
+	uint32_t pre = ((len < 50 ? len : 50) + 3) & ~3u, pa = WL_DMA_PA + (mgmt ? D_TXF : D_TXFRAG);
+	uint16_t flags1 = (uint16_t)((mgmt ? 17u : 16u) << 6 | 1u << 11), id = ++wl_tx_id;
+	memcpy(f, fr, len);
+	frag[0] = WL_DMA_PA + D_TXF;
+	frag[1] = len;
+	frag[2] = frag[3] = 0;
+	p[0] = 1;                                       /* TX_FRM */
+	p[1] = (uint8_t)(1u | (mgmt ? 3u : 1u) << 5);   /* MAC header present, type MGMT / NATIVE_WIFI */
+	p[2] = flags1 & 0xff;                           /* vdev 0, ext tid, POSTPONED */
+	p[3] = flags1 >> 8;
+	p[4] = len & 0xff;
+	p[5] = (uint8_t)(len >> 8);
+	p[6] = id & 0xff;
+	p[7] = (uint8_t)(id >> 8);
+	for (int i = 0; i < 4; i++) {
+		p[8 + i] = (uint8_t)(pa >> (8 * i));
+	}
+	p[12] = p[13] = 0xff;                           /* peer id: invalid; freq 0: home channel */
+	p[14] = p[15] = 0;
+	memcpy(p + 16, f, pre);
+	wl_txc_id = -1;
+	return wl_htc_send(&ce4, wl_htt_ep, 16 + pre);
+}
+
+static bool
+wl_tx_wait(uint32_t ms)
+{
+	for (uint64_t end = wl_ms() + ms; wl_ms() < end && wl_txc_id != wl_tx_id;) {
+		(void)wl_htc_poll(10);
+	}
+	return wl_txc_id == wl_tx_id;
+}
+
+/* 802.11 header to the BSS: A1 BSSID, A2 us, A3 a3. */
+static uint32_t
+wl_hdr(uint8_t *f, uint8_t fc0, uint8_t fc1, const uint8_t *a3)
+{
+	bzero(f, 24);
+	f[0] = fc0;
+	f[1] = fc1;
+	memcpy(f + 4, wl_bss.bssid, 6);
+	memcpy(f + 10, wl_mac, 6);
+	memcpy(f + 16, a3, 6);
+	return 24;
+}
+
+/* Data frame (ToDS) with LLC/SNAP for ethertype. */
+static bool
+wl_data_tx(const uint8_t *da, uint16_t type, const uint8_t *body, uint32_t len)
+{
+	static uint8_t f[2048];
+	uint32_t n = wl_hdr(f, 0x08, 0x01, da);
+	const uint8_t snap[8] = { 0xaa, 0xaa, 3, 0, 0, 0, (uint8_t)(type >> 8), (uint8_t)type };
+	if (n + 8 + len > sizeof(f)) {
+		return false;
+	}
+	memcpy(f + n, snap, 8);
+	memcpy(f + n + 8, body, len);
+	return wl_htt_tx(f, n + 8 + len, false);
+}
+
+static bool
+wl_wmi_simple(uint32_t cmd, uint32_t tag, const uint32_t *v, uint32_t words)
+{
+	uint32_t *w = wl_wmi_begin(cmd, tag, 4 * words);
+	memcpy(w, v, 4 * words);
+	return wl_wmi_send(w + words);
+}
+
+static bool
+wl_install_key(uint32_t idx, uint32_t flags, const uint8_t *key, const uint8_t *rsc)
+{
+	uint32_t *w = wl_wmi_begin(WMI_VDEV_INSTALL_KEY_CMDID, TAG_INSTALL_KEY, 92);
+	wl_put_mac(&w[1], wl_bss.bssid);
+	w[3] = idx;
+	w[4] = flags;                                   /* 0 pairwise, 1 group */
+	w[5] = 4;                                       /* AES_CCM */
+	if (rsc) {
+		w[6] = le32(rsc);
+		w[7] = rsc[4] | rsc[5] << 8;
+	}
+	w[20] = 16;                                     /* key len, no MIC keys */
+	w = wl_tlv(w + 23, TAG_ARRAY_BYTE, 16);
+	memcpy(w, key, 16);
+	if (!wl_wmi_send(w + 4)) {
+		return false;
+	}
+	bool ok = wl_wmi_event(WMI_INSTALL_KEY_DONE_EVTID, 1000);
+	printf("SAILFISH WLAN: key %u (%s) installed: %s status %u\n", idx, flags ? "group" : "pairwise", ok ? "done" : "NO EVENT",
+	    ok ? le32(&wl_msg[8 + 20]) : 0);           /* vdev, peer, key idx, key flags, status */
+	return ok && le32(&wl_msg[8 + 20]) == 0;
+}
+
+/* Our RSN element: group cipher as the AP's, pairwise CCMP, AKM PSK, no capabilities. */
+static uint8_t wl_rsn[22] = { 0x30, 20, 1, 0, 0, 0x0f, 0xac, 4, 1, 0, 0, 0x0f, 0xac, 4, 1, 0, 0, 0x0f, 0xac, 2, 0, 0 };
+
+static bool
+wl_rsn_check(void)
+{
+	const uint8_t *r = wl_bss.rsn, *end = r + wl_bss.rsn_len, *o = r + 8;
+	bool ccmp = false, psk = false;
+	if (wl_bss.rsn_len < 8) {
+		return false;
+	}
+	memcpy(wl_rsn + 4, r + 4, 4);
+	uint32_t n = o + 2 <= end ? (o[0] | o[1] << 8) : 0;
+	for (o += 2; n-- && o + 4 <= end; o += 4) {
+		ccmp |= o[0] == 0 && o[1] == 0x0f && o[2] == 0xac && o[3] == 4;
+	}
+	n = o + 2 <= end ? (o[0] | o[1] << 8) : 0;
+	for (o += 2; n-- && o + 4 <= end; o += 4) {
+		psk |= o[0] == 0 && o[1] == 0x0f && o[2] == 0xac && o[3] == 2;
+	}
+	uint32_t caps = o + 2 <= end ? (o[0] | o[1] << 8) : 0;
+	printf("SAILFISH WLAN: AP RSN: group cipher %u, pairwise CCMP %s, AKM PSK %s, caps %#x\n", r[7], ccmp ? "yes" : "NO",
+	    psk ? "yes" : "NO", caps);
+	return ccmp && psk && r[7] == 4 && !(caps & 0x40);     /* CCMP group; no required MFP */
+}
+
+/* The 4-way handshake: PTK from msg 1, msg 2 back, msg 3 checked, GTK unwrapped, msg 4, keys installed. */
+static bool
+wl_4way(void)
+{
+	static uint8_t e[512], r[EK_DATA + sizeof(wl_rsn)], kd[256];
+	uint8_t pmk[32], ptk[48], snonce[32], anonce[32], gtk[16], gtk_id = 0, rsc[8];
+	bool have_ptk = false, done = false;
+	wl_pmk(wl_psk, wl_ssid, pmk);
+	read_random(snonce, sizeof(snonce));
+	for (uint64_t end = wl_ms() + 10000; wl_ms() < end && !done;) {
+		if (!wl_eapol_len) {
+			(void)wl_htc_poll(10);
+			continue;
+		}
+		uint32_t n = wl_eapol_len;
+		memcpy(e, wl_eapol, n);
+		wl_eapol_len = 0;
+		uint32_t elen = 4u + (e[2] << 8 | e[3]), info = e[EK_INFO] << 8 | e[EK_INFO + 1];
+		uint32_t dlen = e[EK_DATA - 2] << 8 | e[EK_DATA - 1];
+		if (e[1] != 3 || elen > n || elen < EK_DATA || EK_DATA + dlen > elen) {
+			printf("SAILFISH WLAN: EAPOL: not a key frame (type %u len %u of %u)\n", e[1], elen, n);
+			continue;
+		}
+		if ((info & 0x1c8u) == 0x88u) {                 /* msg 1: pairwise, ack, no MIC */
+			uint8_t d[76];
+			bool lo = memcmp(wl_mac, wl_bss.bssid, 6) < 0;
+			memcpy(anonce, e + EK_NONCE, 32);
+			memcpy(d, lo ? wl_mac : wl_bss.bssid, 6);
+			memcpy(d + 6, lo ? wl_bss.bssid : wl_mac, 6);
+			lo = memcmp(snonce, anonce, 32) < 0;
+			memcpy(d + 12, lo ? snonce : anonce, 32);
+			memcpy(d + 44, lo ? anonce : snonce, 32);
+			wl_prf(pmk, 32, "Pairwise key expansion", d, 76, ptk, 48);
+			have_ptk = true;
+			uint32_t rl = EK_DATA + sizeof(wl_rsn);
+			bzero(r, rl);
+			r[0] = 1;
+			r[1] = 3;
+			r[2] = (uint8_t)((rl - 4) >> 8);
+			r[3] = (uint8_t)(rl - 4);
+			r[4] = 2;                               /* RSN key descriptor */
+			r[EK_INFO] = 0x01;                      /* MIC | pairwise | HMAC-SHA1/AES */
+			r[EK_INFO + 1] = 0x0a;
+			memcpy(r + EK_REPLAY, e + EK_REPLAY, 8);
+			memcpy(r + EK_NONCE, snonce, 32);
+			r[EK_DATA - 1] = sizeof(wl_rsn);
+			memcpy(r + EK_DATA, wl_rsn, sizeof(wl_rsn));
+			uint8_t mic[20];
+			wl_hmac_sha1(ptk, 16, r, rl, NULL, 0, mic);
+			memcpy(r + EK_MIC, mic, 16);
+			bool sent = wl_data_tx(wl_bss.bssid, 0x888e, r, rl);
+			printf("SAILFISH WLAN: EAPOL 1/4 (info %#x) -> 2/4 %s\n", info, sent ? "sent" : "SEND FAILED");
+		} else if ((info & 0x1c8u) == 0x1c8u && have_ptk) {   /* msg 3: pairwise, install, ack, MIC */
+			uint8_t mic[20], got[16];
+			memcpy(got, e + EK_MIC, 16);
+			bzero(e + EK_MIC, 16);
+			wl_hmac_sha1(ptk, 16, e, elen, NULL, 0, mic);
+			if (memcmp(mic, got, 16) != 0 || memcmp(e + EK_NONCE, anonce, 32) != 0) {
+				printf("SAILFISH WLAN: EAPOL 3/4: MIC or ANonce mismatch (wrong passphrase?)\n");
+				continue;
+			}
+			bool gtk_ok = false;
+			if ((info & 0x1000u) && dlen <= sizeof(kd) + 8 && wl_unwrap(ptk + 16, e + EK_DATA, dlen, kd)) {
+				for (uint32_t o = 0; o + 2 <= dlen - 8 && o + 2 + kd[o + 1] <= dlen - 8; o += 2u + kd[o + 1]) {
+					if (kd[o] == 0xdd && kd[o + 1] == 6 + 16 && kd[o + 2] == 0 && kd[o + 3] == 0x0f && kd[o + 4] == 0xac &&
+					    kd[o + 5] == 1) {
+						gtk_id = kd[o + 6] & 3;
+						memcpy(gtk, kd + o + 8, 16);
+						gtk_ok = true;
+					}
+				}
+			}
+			memcpy(rsc, e + EK_RSC, 8);
+			uint32_t rl = EK_DATA;
+			bzero(r, rl);
+			r[0] = 1;
+			r[1] = 3;
+			r[3] = EK_DATA - 4;
+			r[4] = 2;
+			r[EK_INFO] = 0x03;                      /* secure | MIC | pairwise | v2 */
+			r[EK_INFO + 1] = 0x0a;
+			memcpy(r + EK_REPLAY, e + EK_REPLAY, 8);
+			wl_hmac_sha1(ptk, 16, r, rl, NULL, 0, mic);
+			memcpy(r + EK_MIC, mic, 16);
+			bool sent = wl_data_tx(wl_bss.bssid, 0x888e, r, rl) && wl_tx_wait(1000);
+			printf("SAILFISH WLAN: EAPOL 3/4 (info %#x, GTK %s id %u) -> 4/4 %s (tx status %u)\n", info, gtk_ok ? "ok" : "MISSING",
+			    gtk_id, sent ? "sent" : "SEND FAILED", wl_txc_status);
+			done = gtk_ok && wl_install_key(0, 0, ptk + 32, NULL) && wl_install_key(gtk_id, 1, gtk, rsc);
+			if (!done) {
+				break;
+			}
+		} else {
+			printf("SAILFISH WLAN: EAPOL key info %#x ignored\n", info);
+		}
+	}
+	bzero(pmk, sizeof(pmk));
+	bzero(ptk, sizeof(ptk));
+	bzero(gtk, sizeof(gtk));
+	return done;
+}
+
+/* DHCP DISCOVER (broadcast) and wait for an OFFER: proves encrypted tx and rx. */
+static bool
+wl_dhcp(void)
+{
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	static uint8_t ip[328];
+	uint8_t *u = ip + 20, *d = u + 8, xid[4];
+	read_random(xid, 4);
+	bzero(ip, sizeof(ip));
+	ip[0] = 0x45;
+	ip[2] = sizeof(ip) >> 8;
+	ip[3] = sizeof(ip) & 0xff;
+	ip[8] = 64;
+	ip[9] = 17;
+	memset(ip + 16, 0xff, 4);
+	uint32_t sum = 0;
+	for (int i = 0; i < 20; i += 2) {
+		sum += (uint32_t)(ip[i] << 8 | ip[i + 1]);
+	}
+	sum = (sum & 0xffff) + (sum >> 16);
+	sum = ~(sum + (sum >> 16)) & 0xffff;
+	ip[10] = (uint8_t)(sum >> 8);
+	ip[11] = (uint8_t)sum;
+	u[1] = 68;
+	u[3] = 67;
+	u[4] = (sizeof(ip) - 20) >> 8;
+	u[5] = (sizeof(ip) - 20) & 0xff;
+	d[0] = 1;                                       /* BOOTREQUEST, ethernet */
+	d[1] = 1;
+	d[2] = 6;
+	memcpy(d + 4, xid, 4);
+	d[10] = 0x80;                                   /* broadcast reply */
+	memcpy(d + 28, wl_mac, 6);
+	static const uint8_t opt[] = { 0x63, 0x82, 0x53, 0x63, 53, 1, 1, 55, 3, 1, 3, 6, 255 };
+	memcpy(d + 236, opt, sizeof(opt));
+	for (int tries = 0; tries < 3; tries++) {
+		wl_ip_len = 0;
+		if (!wl_data_tx(bcast, 0x0800, ip, sizeof(ip))) {
+			return false;
+		}
+		bool txok = wl_tx_wait(500);
+		printf("SAILFISH WLAN: DHCP DISCOVER sent (tx %s, status %u)\n", txok ? "done" : "no completion", wl_txc_status);
+		for (uint64_t end = wl_ms() + 3000; wl_ms() < end;) {
+			(void)wl_htc_poll(10);
+			if (wl_ip_len < 28 + 240 || wl_ip[9] != 17) {
+				continue;
+			}
+			const uint8_t *ru = wl_ip + (wl_ip[0] & 15) * 4, *rd = ru + 8;
+			wl_ip_len = 0;
+			if (ru[3] != 68 || rd[0] != 2 || memcmp(rd + 4, xid, 4) != 0) {
+				continue;
+			}
+			printf("SAILFISH WLAN: DHCP OFFER: %u.%u.%u.%u from %u.%u.%u.%u\n", rd[16], rd[17], rd[18], rd[19],
+			    wl_ip[12], wl_ip[13], wl_ip[14], wl_ip[15]);
+			return true;
+		}
+	}
+	printf("SAILFISH WLAN: no DHCP OFFER (%u MSDUs received)\n", wl_htt_rx);
+	return false;
+}
+
+static bool
+wl_connect(void)
+{
+	if (!wl_crypto_selftest()) {
+		return false;
+	}
+	if (!wl_bss.found) {
+		printf("SAILFISH WLAN: \"%s\" not found by the scan\n", wl_ssid);
+		return false;
+	}
+	uint32_t ch = wl_bss.ch, freq = ch <= 14 ? 2407 + 5 * ch : 5000 + 5 * ch, nr;
+	bool g = ch <= 14;
+	printf("SAILFISH WLAN: joining \"%s\": ch %u (%u MHz) snr %u cap %#x\n", wl_ssid, ch, freq, wl_bss.snr, wl_bss.cap);
+	if (!wl_rsn_check()) {
+		printf("SAILFISH WLAN: unsupported security (need WPA2-PSK with CCMP)\n");
+		return false;
+	}
+	wl_step("connect");
+	uint32_t ps[2] = { 0, 0 };                      /* vdev 0: power save off */
+	if (!wl_wmi_simple(WMI_STA_PS_MODE_CMDID, TAG_STA_PS_MODE, ps, 2)) {
+		return false;
+	}
+	uint32_t *w = wl_wmi_begin(WMI_VDEV_START_CMDID, TAG_VDEV_START, 72);
+	w[2] = 100;                                     /* beacon interval, DTIM 1 */
+	w[3] = 1;
+	w = wl_tlv(w + 18, TAG_CHANNEL, 24);
+	w[0] = freq;
+	w[1] = freq;
+	w[3] = g ? 1u : 0u;                             /* MODE_11G / MODE_11A */
+	w[4] = 40u << 8 | 40u << 16;
+	w[5] = 40u << 8;
+	w = wl_tlv(w + 6, TAG_ARRAY_STRUC, 0);
+	if (!wl_wmi_send(w) || !wl_wmi_event(WMI_VDEV_START_RESP_EVTID, 2000)) {
+		printf("SAILFISH WLAN: vdev start: no response\n");
+		return false;
+	}
+	printf("SAILFISH WLAN: vdev start: status %u\n", le32(&wl_msg[8 + 12]));
+	uint32_t pc[4] = { 0, 0, 0, 0 };
+	wl_put_mac(&pc[1], wl_bss.bssid);
+	if (!wl_wmi_simple(WMI_PEER_CREATE_CMDID, TAG_PEER_CREATE, pc, 4)) {
+		return false;
+	}
+	for (int i = 0; i < 20; i++) {
+		(void)wl_htc_poll(10);                  /* HTT PEER_MAP */
+	}
+
+	wl_step("auth");
+	static uint8_t f[256];
+	const uint8_t *rsp = NULL;
+	uint32_t n = wl_hdr(f, 0xb0, 0, wl_bss.bssid), rl = 0;
+	bzero(f + n, 6);
+	f[n + 2] = 1;                                   /* open system, seq 1 */
+	n += 6;
+	for (int i = 0; i < 3 && !rsp; i++) {
+		if (!wl_htt_tx(f, n, true)) {
+			return false;
+		}
+		rsp = wl_wait_mgmt(0xb0, 500, &rl);
+	}
+	uint32_t st = rsp && rl >= 30 ? (rsp[28] | rsp[29] << 8) : 0xffff;
+	printf("SAILFISH WLAN: auth: %s status %u (tx completion id %d status %u)\n", rsp ? "response" : "NO RESPONSE", st, wl_txc_id,
+	    wl_txc_status);
+	if (st) {
+		return false;
+	}
+
+	wl_step("assoc");
+	static const uint8_t rates_g[12] = { 0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24, 0x30, 0x48, 0x60, 0x6c };
+	static const uint8_t rates_a[8] = { 0x8c, 0x12, 0x98, 0x24, 0xb0, 0x48, 0x60, 0x6c };
+	const uint8_t *rates = g ? rates_g : rates_a;
+	nr = g ? 12 : 8;
+	n = wl_hdr(f, 0x00, 0, wl_bss.bssid);
+	uint32_t cap = 0x0011u | (g ? (wl_bss.cap & 0x0420u) : 0);     /* ESS, privacy (+ short preamble / slot) */
+	f[n++] = cap & 0xff;
+	f[n++] = (uint8_t)(cap >> 8);
+	f[n++] = 10;                                    /* listen interval */
+	f[n++] = 0;
+	f[n++] = 0;
+	f[n++] = (uint8_t)strlen(wl_ssid);
+	memcpy(f + n, wl_ssid, strlen(wl_ssid));
+	n += strlen(wl_ssid);
+	f[n++] = 1;
+	f[n++] = 8;
+	memcpy(f + n, rates, 8);
+	n += 8;
+	if (g) {
+		f[n++] = 50;                            /* extended supported rates */
+		f[n++] = 4;
+		memcpy(f + n, rates_g + 8, 4);
+		n += 4;
+	}
+	memcpy(f + n, wl_rsn, sizeof(wl_rsn));
+	n += sizeof(wl_rsn);
+	rsp = NULL;
+	for (int i = 0; i < 3 && !rsp; i++) {
+		if (!wl_htt_tx(f, n, true)) {
+			return false;
+		}
+		rsp = wl_wait_mgmt(0x10, 500, &rl);
+	}
+	st = rsp && rl >= 30 ? (rsp[26] | rsp[27] << 8) : 0xffff;
+	uint32_t aid = rsp && rl >= 30 ? (rsp[28] | rsp[29] << 8) & 0x3fffu : 0;
+	printf("SAILFISH WLAN: assoc: %s status %u aid %u\n", rsp ? "response" : "NO RESPONSE", st, aid);
+	if (st) {
+		return false;
+	}
+	w = wl_wmi_begin(WMI_PEER_ASSOC_CMDID, TAG_PEER_ASSOC, 76);
+	wl_put_mac(w, wl_bss.bssid);
+	w[3] = 1;                                       /* new assoc */
+	w[4] = aid;
+	w[5] = 0x1u | 0x4u;                             /* AUTH, NEED_PTK_4_WAY */
+	w[6] = wl_bss.cap;
+	w[7] = 10;
+	w[12] = 1;                                      /* nss */
+	w[14] = g ? 1u : 0u;                            /* MODE_11G / MODE_11A */
+	w[17] = nr;
+	w = wl_tlv(w + 19, TAG_ARRAY_BYTE, (nr + 3) & ~3u);
+	memcpy(w, rates, nr);
+	w = wl_tlv(w + (nr + 3) / 4, TAG_ARRAY_BYTE, 0);
+	w = wl_tlv(w, TAG_VHT_RATE_SET, 16);
+	if (!wl_wmi_send(w + 4)) {
+		return false;
+	}
+	uint32_t up[4] = { 0, aid, 0, 0 };
+	wl_put_mac(&up[2], wl_bss.bssid);
+	if (!wl_wmi_simple(WMI_VDEV_UP_CMDID, TAG_VDEV_UP, up, 4)) {
+		return false;
+	}
+
+	wl_step("4-way handshake");
+	if (!wl_4way()) {
+		printf("SAILFISH WLAN: 4-way handshake FAILED (%u MSDUs received)\n", wl_htt_rx);
+		return false;
+	}
+	uint32_t auth[5] = { 0, 0, 0, 3, 1 };           /* peer param AUTHORIZE = 1 */
