+/*
+ * Stage 4: join a WPA2-PSK (CCMP) network the way ath10k + mac80211 +
+ * wpa_supplicant do it: vdev start on the BSS channel, peer create,
+ * open-system auth and association (management frames over HTT TX_FRM),
+ * peer assoc + vdev up, then the 4-way handshake with our own supplicant
+ * (EAPOL in native-wifi frames over HTT), PTK/GTK into the firmware, peer
+ * authorized. A DHCP DISCOVER then checks the encrypted data path.
+ */
+#define WMI_VDEV_START_CMDID            0x5003u
+#define WMI_VDEV_UP_CMDID               0x5005u
+#define WMI_VDEV_INSTALL_KEY_CMDID      0x5009u
+#define WMI_PEER_CREATE_CMDID           0x6001u
+#define WMI_PEER_SET_PARAM_CMDID        0x6004u
+#define WMI_PEER_ASSOC_CMDID            0x6005u
+#define WMI_STA_PS_MODE_CMDID           0x9001u
+#define WMI_VDEV_START_RESP_EVTID       0x5001u
+#define WMI_INSTALL_KEY_DONE_EVTID      0x5003u
+#define TAG_VDEV_START                  0x58u
+#define TAG_VDEV_UP                     0x5cu
+#define TAG_INSTALL_KEY                 0x60u
+#define TAG_PEER_CREATE                 0x61u
+#define TAG_PEER_SET_PARAM              0x64u
+#define TAG_PEER_ASSOC                  0x65u
+#define TAG_VHT_RATE_SET                0x66u
+#define TAG_STA_PS_MODE                 0x6cu
+#define D_TXFRAG                        0x21800u        /* HTT tx fragment list: {paddr, len}, {0, 0} */
+#define D_TXF                           0x22000u        /* HTT tx frame, 2 KB */
+
+/* EAPOL-Key frame offsets, 802.1X header included. */
+#define EK_INFO         5
+#define EK_REPLAY       9
+#define EK_NONCE        17
+#define EK_RSC          65
+#define EK_MIC          81
+#define EK_DATA         99      /* key data length at 97 */
+
+/* HMAC-SHA1 over a || b (key at most 64 bytes); out may alias a. */
+static void
+wl_hmac_sha1(const void *key, size_t klen, const void *a, size_t alen, const void *b, size_t blen, uint8_t out[20])
+{
+	uint8_t k[64] = { 0 }, pad[64];
+	SHA1_CTX c;
+	memcpy(k, key, klen);
+	for (int i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x36;
+	}
+	SHA1Init(&c);
+	SHA1Update(&c, pad, 64);
+	SHA1Update(&c, a, alen);
+	if (blen) {
+		SHA1Update(&c, b, blen);
+	}
+	SHA1Final(out, &c);
+	for (int i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x5c;
+	}
+	SHA1Init(&c);
+	SHA1Update(&c, pad, 64);
+	SHA1Update(&c, out, 20);
+	SHA1Final(out, &c);
 }
 
+/* PMK = PBKDF2-HMAC-SHA1(passphrase, ssid, 4096, 32) */
 static void
+wl_pmk(const char *psk, const char *ssid, uint8_t pmk[32])
+{
+	size_t pl = strlen(psk), sl = strlen(ssid);
+	for (uint8_t blk = 1; blk <= 2; blk++) {
+		uint8_t cnt[4] = { 0, 0, 0, blk }, u[20], t[20];
+		wl_hmac_sha1(psk, pl, ssid, sl, cnt, 4, u);
+		memcpy(t, u, 20);
+		for (int i = 1; i < 4096; i++) {
+			wl_hmac_sha1(psk, pl, u, 20, NULL, 0, u);
+			for (int j = 0; j < 20; j++) {
+				t[j] ^= u[j];
+			}
+		}
+		memcpy(pmk + 20 * (blk - 1), t, blk == 1 ? 20 : 12);
+	}
+}
+
+/* IEEE 802.11 PRF-SHA1: HMAC(key, label || 0 || data || i), i = 0, 1, ... */
+static void
+wl_prf(const uint8_t *key, size_t klen, const char *label, const uint8_t *data, size_t dlen, uint8_t *out, size_t olen)
+{
+	uint8_t buf[128], h[20];
+	size_t ll = strlen(label) + 1;
+	memcpy(buf, label, ll);
+	memcpy(buf + ll, data, dlen);
+	for (uint8_t i = 0; olen; i++) {
+		size_t n = olen < 20 ? olen : 20;
+		buf[ll + dlen] = i;
+		wl_hmac_sha1(key, klen, buf, ll + dlen + 1, NULL, 0, h);
+		memcpy(out, h, n);
+		out += n;
+		olen -= n;
+	}
+}
+
+/* RFC 3394 AES key unwrap (128-bit KEK): len bytes in, len - 8 out. */
+static bool
+wl_unwrap(const uint8_t kek[16], const uint8_t *in, size_t len, uint8_t *out)
+{
+	size_t n = len / 8 - 1;
+	uint8_t a[8], b[16];
+	aes_decrypt_ctx ctx;
+	if (len < 24 || len % 8) {
+		return false;
+	}
+	aes_decrypt_key128(kek, &ctx);
+	memcpy(a, in, 8);
+	memcpy(out, in + 8, 8 * n);
+	for (int j = 5; j >= 0; j--) {
+		for (size_t i = n; i >= 1; i--) {
+			uint64_t t = (uint64_t)n * (uint64_t)j + i;
+			memcpy(b, a, 8);
+			for (int k = 0; k < 8; k++) {
+				b[7 - k] ^= (uint8_t)(t >> (8 * k));
+			}
+			memcpy(b + 8, out + 8 * (i - 1), 8);
+			aes_decrypt(b, b, &ctx);
+			memcpy(a, b, 8);
+			memcpy(out + 8 * (i - 1), b + 8, 8);
+		}
+	}
+	for (int k = 0; k < 8; k++) {
+		if (a[k] != 0xa6) {
+			return false;
+		}
+	}
+	return true;
+}
