 /*
+ * Group key handshake (the AP rotates the GTK, often hourly): msg 1 checked
+ * and replay-protected, new GTK installed, msg 2 back. False on a pairwise
+ * msg 1 (PTK rekey): the caller rejoins.
+ */
+static bool
+wl_rekey(void)
+{
+	static uint8_t e[512], r[EK_DATA], kd[256];
+	uint8_t mic[20], got[16], gtk[16], gtk_id = 0;
+	uint32_t n = wl_eapol_len;
+	memcpy(e, wl_eapol, n);
+	wl_eapol_len = 0;
+	uint32_t elen = 4u + (e[2] << 8 | e[3]), info = e[EK_INFO] << 8 | e[EK_INFO + 1];
+	uint32_t dlen = e[EK_DATA - 2] << 8 | e[EK_DATA - 1];
+	if (e[1] != 3 || elen > n || elen < EK_DATA || EK_DATA + dlen > elen) {
+		return true;
+	}
+	if (info & 0x8u) {
+		printf("SAILFISH WLAN: EAPOL pairwise key info %#x while connected (PTK rekey)\n", info);
+		return false;
+	}
+	if ((info & 0x13c0u) != 0x1380u) {              /* group msg 1: encrypted data, secure, MIC, ack */
+		printf("SAILFISH WLAN: EAPOL key info %#x ignored\n", info);
+		return true;
+	}
+	memcpy(got, e + EK_MIC, 16);
+	bzero(e + EK_MIC, 16);
+	wl_hmac_sha1(wl_ptk, 16, e, elen, NULL, 0, mic);
+	if (memcmp(mic, got, 16) != 0 || memcmp(e + EK_REPLAY, wl_replay, 8) <= 0) {
+		printf("SAILFISH WLAN: group rekey: MIC mismatch or replayed\n");
+		return true;
+	}
+	if (dlen < 16 || dlen > sizeof(kd) + 8 || !wl_unwrap(wl_ptk + 16, e + EK_DATA, dlen, kd) || !wl_gtk(kd, dlen - 8, gtk, &gtk_id)) {
+		printf("SAILFISH WLAN: group rekey: no GTK\n");
+		return true;
+	}
+	memcpy(wl_replay, e + EK_REPLAY, 8);
+	bzero(r, sizeof(r));
+	r[0] = 1;
+	r[1] = 3;
+	r[3] = EK_DATA - 4;
+	r[4] = 2;
+	r[EK_INFO] = 0x03;                              /* secure | MIC | group | v2 */
+	r[EK_INFO + 1] = 0x02;
+	memcpy(r + EK_REPLAY, e + EK_REPLAY, 8);
+	wl_hmac_sha1(wl_ptk, 16, r, sizeof(r), NULL, 0, mic);
+	memcpy(r + EK_MIC, mic, 16);
+	bool sent = wl_data_tx(wl_bss.bssid, 0x888e, r, sizeof(r));
+	bool ok = wl_install_key(gtk_id, 1, gtk, e + EK_RSC);
+	printf("SAILFISH WLAN: group rekey: GTK id %u %s, 2/2 %s\n", gtk_id, ok ? "installed" : "INSTALL FAILED",
+	    sent ? "sent" : "SEND FAILED");
+	bzero(gtk, sizeof(gtk));
+	return true;
+}
