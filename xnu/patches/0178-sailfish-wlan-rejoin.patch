+/* GTK KDE in unwrapped key data kd (len bytes): key and id; false if absent. */
+static bool
+wl_gtk(const uint8_t *kd, uint32_t len, uint8_t gtk[16], uint8_t *id)
+{
+	for (uint32_t o = 0; o + 2 <= len && o + 2 + kd[o + 1] <= len; o += 2u + kd[o + 1]) {
+		if (kd[o] == 0xdd && kd[o + 1] == 6 + 16 && kd[o + 2] == 0 && kd[o + 3] == 0x0f && kd[o + 4] == 0xac && kd[o + 5] == 1) {
+			*id = kd[o + 6] & 3;
+			memcpy(gtk, kd + o + 8, 16);
+			return true;
+		}
+	}
+	return false;
 }
 
