+/* Connection lost: link down for iOS, rejoin with backoff until it works (or the PCIe link is gone). */
+static void
+wl_rejoin(const char *why)
+{
+	printf("SAILFISH WLAN: connection lost (%s), rejoining\n", why);
+	wl_net_up = false;
+	sailfish_wlan_iokit_link(false);
+	sweet_log_kick();
+	/* ponytail: same BSS and channel; an AP that moved channel needs a rescan here. */
+	for (uint32_t ms = 1000; wl_link("rejoin"); ms = ms < 16000 ? 2 * ms : 30000) {
+		wl_leave();
+		if (wl_join()) {
+			wl_net_up = true;
+			sailfish_wlan_iokit_link(true);
+			break;
+		}
+		wl_msleep(ms);
+	}
+	sweet_log_kick();
 }
 
