+/* Post the 2 KB rx buffer at DMA offset off into c's next dst slot. */
 static void
+wl_rx_post(struct wl_ce *c, uint32_t off)
+{
+	c->buf[c->dwr] = off;
+	wl_ce_post(c, WL_DMA_PA + off);
+}
+
+/* Next completed rx buffer of c: bytes (0 if none) and its DMA offset; repost it after use. */
+static uint32_t
+wl_rx_get(struct wl_ce *c, uint32_t *off)
+{
+	uint32_t slot = c->drd, n = wl_ce_recv(c);
+	if (n) {
+		*off = c->buf[slot];
+	}
+	return n;
+}
