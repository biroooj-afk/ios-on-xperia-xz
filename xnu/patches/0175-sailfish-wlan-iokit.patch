+/*
+ * The Pixel 1's QCA6174 Wi-Fi as an IOEthernetController, so that iOS's
+ * configd names it (en0 through IONetworkStack) and IPConfiguration runs
+ * DHCP on it. The radio, firmware, association and WPA2 live in
+ * bsd/dev/sailfish_wlan.c; this class only bridges frames and link state.
+ *
+ * The IORegistry is held busy from start() until the interface exists:
+ * configd builds the first network configuration (a DHCP service per
+ * interface, kept in preferences.plist) when IOKit goes quiet.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/network/IOEthernetController.h>
+#include <IOKit/network/IOEthernetInterface.h>
+#include <IOKit/network/IONetworkMedium.h>
+#include <IOKit/network/IOOutputQueue.h>      /* kIOReturnOutputSuccess */
+#include <pexpert/pexpert.h>
+
+/* bsd/dev/sailfish_wlan.c */
+extern "C" void sailfish_wlan_output(mbuf_t m);
+
+#define WLAN_SPEED      54000000ULL     /* legacy 11g rates for now */
+
+class SailfishWLAN : public IOEthernetController {
+	OSDeclareDefaultStructors(SailfishWLAN);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	bool createWorkLoop(void) APPLE_KEXT_OVERRIDE;
+	IOWorkLoop *getWorkLoop(void) const APPLE_KEXT_OVERRIDE;
+	IOReturn enable(IONetworkInterface *netif) APPLE_KEXT_OVERRIDE;
+	IOReturn disable(IONetworkInterface *netif) APPLE_KEXT_OVERRIDE;
+	IOReturn getHardwareAddress(IOEthernetAddress *addr) APPLE_KEXT_OVERRIDE;
+	UInt32 outputPacket(mbuf_t m, void *param) APPLE_KEXT_OVERRIDE;
+	IOReturn setMulticastMode(bool active) APPLE_KEXT_OVERRIDE;
+	IOReturn setMulticastList(IOEthernetAddress *addrs, UInt32 count) APPLE_KEXT_OVERRIDE;
+	IOReturn setPromiscuousMode(bool active) APPLE_KEXT_OVERRIDE;
+
+	void attach(const uint8_t *mac);
+	void link(bool up);
+	void input(mbuf_t m);
+private:
+	IOWorkLoop *fLoop;
+	IOEthernetInterface *fNetif;
+	IONetworkMedium *fMedium;
+	IOEthernetAddress fMac;
+	bool fBusy;
+};
+OSDefineMetaClassAndStructors(SailfishWLAN, IOEthernetController);
+#define super IOEthernetController
+
+static SailfishWLAN *gWLAN;
+
+bool
+SailfishWLAN::start(IOService *provider)
+{
+	int on = 0;
+	if (!PE_parse_boot_argn("sailfishwlan", &on, sizeof(on)) || !on) {
+		return false;
+	}
+	IOLog("SAILFISH WLAN: IOEthernetController start\n");
+	if (!super::start(provider)) {
+		IOLog("SAILFISH WLAN: IONetworkController::start FAILED\n");
+		return false;
+	}
+	OSDictionary *media = OSDictionary::withCapacity(1);
+	fMedium = IONetworkMedium::medium(kIOMediumEthernetAuto, WLAN_SPEED);
+	if (!media || !fMedium || !IONetworkMedium::addMedium(media, fMedium) || !publishMediumDictionary(media)) {
+		IOLog("SAILFISH WLAN: medium dictionary FAILED\n");
+		OSSafeReleaseNULL(media);
+		return false;
+	}
+	media->release();
+	fBusy = true;
+	adjustBusy(1);          /* until attach(): configd waits for IOKit quiet */
+	gWLAN = this;
+	IOLog("SAILFISH WLAN: IOEthernetController started, waiting for the radio\n");
+	return true;
+}
+
+bool
+SailfishWLAN::createWorkLoop(void)
+{
+	fLoop = IOWorkLoop::workLoop();
+	return fLoop != NULL;
+}
+
+IOWorkLoop *
+SailfishWLAN::getWorkLoop(void) const
+{
+	return fLoop;
+}
+
+IOReturn
+SailfishWLAN::enable(IONetworkInterface *netif __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SailfishWLAN::disable(IONetworkInterface *netif __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SailfishWLAN::getHardwareAddress(IOEthernetAddress *addr)
+{
+	*addr = fMac;
+	return kIOReturnSuccess;
+}
+
+UInt32
+SailfishWLAN::outputPacket(mbuf_t m, void *param __unused)
+{
+	sailfish_wlan_output(m);        /* takes the mbuf */
+	return kIOReturnOutputSuccess;
+}
+
+/* The firmware passes all multicast and broadcast frames of the BSS. */
+IOReturn
+SailfishWLAN::setMulticastMode(bool active __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SailfishWLAN::setMulticastList(IOEthernetAddress *addrs __unused, UInt32 count __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SailfishWLAN::setPromiscuousMode(bool active __unused)
+{
+	return kIOReturnSuccess;
+}
+
+/* The radio knows its MAC address (or failed: mac NULL): publish the interface, release IOKit. */
+void
+SailfishWLAN::attach(const uint8_t *mac)
+{
+	if (mac) {
+		memcpy(fMac.bytes, mac, sizeof(fMac.bytes));
+		setLinkStatus(kIONetworkLinkValid, NULL);
+		if (attachInterface((IONetworkInterface **)&fNetif, true)) {
+			IOLog("SAILFISH WLAN: IOEthernetInterface attached\n");
+		} else {
+			IOLog("SAILFISH WLAN: attachInterface FAILED\n");
+		}
+	}
+	if (fBusy) {
+		fBusy = false;
+		adjustBusy(-1);
+	}
+}
+
+void
+SailfishWLAN::link(bool up)
+{
+	setLinkStatus(up ? kIONetworkLinkValid | kIONetworkLinkActive : kIONetworkLinkValid, up ? fMedium : NULL,
+	    up ? WLAN_SPEED : 0);
+	IOLog("SAILFISH WLAN: link %s\n", up ? "up" : "down");
+}
+
+void
+SailfishWLAN::input(mbuf_t m)
+{
+	if (fNetif) {
+		fNetif->inputPacket(m);
+	} else {
+		mbuf_freem(m);
+	}
+}
+
+/* For bsd/dev/sailfish_wlan.c (its thread runs after IOKit matched us, or never finds gWLAN). */
+extern "C" bool
+sailfish_wlan_iokit_attach(const uint8_t *mac)
+{
+	if (!gWLAN) {
+		return false;
+	}
+	gWLAN->attach(mac);
+	return true;
+}
+
+extern "C" void
+sailfish_wlan_iokit_link(bool up)
+{
+	if (gWLAN) {
+		gWLAN->link(up);
+	}
+}
+
+extern "C" void
+sailfish_wlan_iokit_input(mbuf_t m)
+{
+	if (gWLAN) {
+		gWLAN->input(m);
+	} else {
+		mbuf_freem(m);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
