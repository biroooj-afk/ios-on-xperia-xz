+static bool
+wl_dhcp(void)
+{
+	uint8_t xid[4], got = 0;
+	read_random(xid, 4);
+	for (int tries = 0; tries < 4 && got != 2; tries++) {
+		got = wl_dhcp_send(xid, 1) ? wl_dhcp_wait(xid, 2, 3000) : 0;
+	}
+	if (got != 2) {
+		printf("SAILFISH WLAN: DHCP: no OFFER (%u MSDUs received)\n", wl_htt_rx);
+		return false;
+	}
+	for (int tries = 0; tries < 4 && got != 5 && got != 6; tries++) {
+		got = wl_dhcp_send(xid, 3) ? wl_dhcp_wait(xid, 5, 3000) : 0;
+	}
+	printf("SAILFISH WLAN: DHCP %s: %u.%u.%u.%u/%u.%u.%u.%u router %u.%u.%u.%u dns %u.%u.%u.%u lease %u s\n",
+	    got == 5 ? "ACK" : got == 6 ? "NAK" : "no ACK", wl_lease_ip[0], wl_lease_ip[1], wl_lease_ip[2], wl_lease_ip[3],
+	    wl_lease_mask[0], wl_lease_mask[1], wl_lease_mask[2], wl_lease_mask[3], wl_lease_gw[0], wl_lease_gw[1], wl_lease_gw[2],
+	    wl_lease_gw[3], wl_lease_dns[0], wl_lease_dns[1], wl_lease_dns[2], wl_lease_dns[3], wl_lease_secs);
+	return got == 5;
 }
 
+/*
+ * en0: an Ethernet interface for the stack (as ue0 in sweet_usb.c). Output
+ * only queues; the Wi-Fi thread converts and sends (wl_run).
+ */
+#define WL_IFQ 64u
+static lck_mtx_t *wl_ifq_lock;
+static mbuf_t wl_ifq[WL_IFQ];
+static uint32_t wl_ifq_head, wl_ifq_count;
+
+static errno_t
+wl_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(wl_ifq_lock);
+	if (wl_ifq_count == WL_IFQ) {
+		lck_mtx_unlock(wl_ifq_lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	wl_ifq[(wl_ifq_head + wl_ifq_count++) % WL_IFQ] = m;
+	lck_mtx_unlock(wl_ifq_lock);
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	return 0;
+}
+
+static errno_t
+wl_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data __unused)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+wl_if_detach(ifnet_t ifp __unused)
+{
+}
+
+static void
+wl_sin(struct sockaddr_in *a, const uint8_t ip[4])
+{
+	bzero(a, sizeof(*a));
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	memcpy(&a->sin_addr, ip, 4);
+}
+
 static bool
+wl_if_create(void)
+{
+	struct ifnet_init_eparams init;
+	ifnet_t ifp = NULL;
+	wl_ifq_lock = lck_mtx_alloc_init(lck_grp_alloc_init("sailfish_wlan", LCK_GRP_ATTR_NULL), LCK_ATTR_NULL);
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "sailfish-wlan";
+	init.uniqueid_len = sizeof("sailfish-wlan") - 1;
+	init.name = "en";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = wl_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = wl_if_ioctl;
+	init.detach = wl_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ifp) != 0) {
+		printf("SAILFISH WLAN: en0: ifnet_allocate failed\n");
+		return false;
+	}
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_baudrate(ifp, 54000000);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ifp, NULL) != 0) {
+		printf("SAILFISH WLAN: en0: ifnet_attach failed\n");
+		return false;
+	}
+	ifnet_set_lladdr(ifp, wl_mac, ETHER_ADDR_LEN);
+	wl_ifp = ifp;
+
+	errno_t err = proto_plumb(PF_INET, ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		uint8_t bc[4];
+		for (int i = 0; i < 4; i++) {
+			bc[i] = (uint8_t)(wl_lease_ip[i] | ~wl_lease_mask[i]);
+		}
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "en0");
+		wl_sin((struct sockaddr_in *)&ifra.ifra_addr, wl_lease_ip);
+		wl_sin((struct sockaddr_in *)&ifra.ifra_mask, wl_lease_mask);
+		wl_sin((struct sockaddr_in *)&ifra.ifra_broadaddr, bc);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	int rerr = -1;
+	if (err == 0 && wl_lease_gw[0]) {                /* default route via the router */
+		static const uint8_t zero[4];
+		struct sockaddr_in dst, gw, mask;
+		wl_sin(&dst, zero);
+		wl_sin(&gw, wl_lease_gw);
+		wl_sin(&mask, zero);
+		rerr = rtrequest(RTM_ADD, (struct sockaddr *)&dst, (struct sockaddr *)&gw, (struct sockaddr *)&mask,
+		    RTF_UP | RTF_GATEWAY | RTF_STATIC, NULL);
+	}
+	printf("SAILFISH WLAN: en0 %s: %u.%u.%u.%u (err %d), default route %s (err %d)\n", err ? "NOT configured" : "up",
+	    wl_lease_ip[0], wl_lease_ip[1], wl_lease_ip[2], wl_lease_ip[3], err, rerr == 0 ? "set" : "NOT set", rerr);
+	return err == 0;
+}
