+/*
+ * The data path, polled (ponytail: 1 ms poll on this thread; the CE
+ * interrupts would let it sleep): queued Ethernet frames out as
+ * native-wifi data, received frames go in through wl_rx_msdu.
+ */
+static void
+wl_run(void)
+{
+	static uint8_t fr[ETHER_MAX_LEN];
+	uint32_t events = 0;
+	for (;;) {
+		mbuf_t m = NULL;
+		lck_mtx_lock(wl_ifq_lock);
+		if (wl_ifq_count) {
+			m = wl_ifq[wl_ifq_head];
+			wl_ifq_head = (wl_ifq_head + 1) % WL_IFQ;
+			wl_ifq_count--;
+		}
+		lck_mtx_unlock(wl_ifq_lock);
+		if (m) {
+			size_t len = mbuf_pkthdr_len(m);
+			if (len > ETHER_HDR_LEN && len <= sizeof(fr) && mbuf_copydata(m, 0, len, fr) == 0) {
+				(void)wl_data_tx(fr, (uint16_t)(fr[12] << 8 | fr[13]), fr + ETHER_HDR_LEN, (uint32_t)(len - ETHER_HDR_LEN));
+			}
+			mbuf_freem(m);
+		}
+		uint8_t eid = wl_htc_poll(0);
+		if (eid == wl_wmi_ep && wl_msg_len >= 4 && wl_noisy(le32(wl_msg) & 0xffffffu) && events++ < 50) {
+			printf("SAILFISH WLAN: WMI event %#x (%u bytes)\n", le32(wl_msg) & 0xffffffu, wl_msg_len);
+		}
+		if (!m && eid == 0xff) {
+			wl_msleep(1);
+		}
+	}
+}
