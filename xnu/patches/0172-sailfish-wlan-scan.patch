+/*
+ * ath10k_htt_setup: version handshake, then one rx ring (ath10k
+ * send_rx_ring_cfg_32: 2 KB buffers, all frame types, offsets of
+ * htt_rx_desc_v1 in words: attention 1, frag 2, mpdu start 3, msdu start 6,
+ * msdu end 10, mpdu end 20, ppdu start 21, ppdu end 31, header 59,
+ * payload 75). The firmware's receive path needs it.
+ */
+static bool
+wl_htt_setup(void)
+{
+	if (wl_htt_ep == 0xff) {
+		return false;
+	}
+	uint8_t *p = wl_htc_tx_payload(&ce4);
+	bzero(p, 4);                                    /* VERSION_REQ */
+	if (!wl_htc_send(&ce4, wl_htt_ep, 4)) {
+		return false;
+	}
+	bool ver = false;
+	for (int i = 0; i < 100 && !ver; i++) {
+		ver = wl_htc_poll(10) == wl_htt_ep && wl_msg[0] == 0;
+	}
+	printf("SAILFISH WLAN: HTT version %u.%u%s\n", wl_msg[2], wl_msg[1], ver ? "" : " (NO REPLY)");
+	if (!ver) {
+		return false;
+	}
+	volatile uint32_t *ring = (volatile uint32_t *)(wl_dma + D_HTT_RING);
+	for (uint32_t i = 0; i < HTT_RING_N; i++) {
+		ring[i] = WL_DMA_PA + D_HTT_BUF + 2048 * i;
+	}
+	wl_htt_alloc = HTT_RING_N - 1;
+	*(volatile uint32_t *)(wl_dma + D_HTT_IDX) = wl_htt_alloc;
+	static const uint16_t offs[10] = { 59, 75, 21, 31, 3, 20, 6, 10, 1, 2 };
+	bzero(p, 40);
+	p[0] = 2;                                       /* RX_RING_CFG */
+	p[1] = 1;                                       /* one ring */
+	uint32_t *q = (uint32_t *)(p + 4);
+	q[0] = WL_DMA_PA + D_HTT_IDX;                   /* fw_idx_shadow_reg_paddr */
+	q[1] = WL_DMA_PA + D_HTT_RING;
+	uint16_t *h = (uint16_t *)(p + 12);
+	h[0] = HTT_RING_N;
+	h[1] = 2048;
+	h[2] = 0xffff;                                  /* all HTT_RX_RING_FLAGS_ */
+	h[3] = (uint16_t)wl_htt_alloc;
+	for (int i = 0; i < 10; i++) {
+		h[4 + i] = offs[i];
+	}
+	if (!wl_htc_send(&ce4, wl_htt_ep, 40)) {
+		return false;
+	}
+	printf("SAILFISH WLAN: HTT rx ring: %u x 2 KB at %#x\n", HTT_RING_N, WL_DMA_PA + D_HTT_BUF);
+	return true;
 }
 
