+
+/*
+ * Stage 3b: a passive scan (ath10k: update_channel_list, vdev create,
+ * hw_scan defaults). Beacons and probe responses arrive as WMI MGMT_RX
+ * events: header TLV, then the 802.11 frame as a byte array.
+ */
+#define WMI_START_SCAN_CMDID    0x3001u
+#define WMI_SCAN_CHAN_LIST_CMDID 0x3003u
+#define WMI_VDEV_CREATE_CMDID   0x5001u
+#define WMI_SCAN_EVTID          0x3001u
+#define WMI_MGMT_RX_EVTID       0x7001u
+#define TAG_ARRAY_UINT32        0x10u
+#define TAG_ARRAY_BYTE          0x11u
+#define TAG_ARRAY_FIXED_STRUC   0x13u
+#define TAG_START_SCAN          0x4du
+#define TAG_SCAN_CHAN_LIST      0x4fu
+#define TAG_CHANNEL             0x50u
+#define TAG_VDEV_CREATE         0x56u
+
+static bool
+wl_wmi_send(uint32_t *end)
+{
+	uint8_t *p = wl_htc_tx_payload(&ce3);
+	return wl_htc_send(&ce3, wl_wmi_ep, (uint32_t)((uint8_t *)end - p));
+}
+
+static uint32_t
+wl_freq(unsigned i)             /* scan channels: 2.4 GHz 1-13, 5 GHz 36-48 */
+{
+	return i < 13 ? 2412 + 5 * i : 5180 + 20 * (i - 13);
+}
+#define WL_NCHAN 17u
+
+static bool
+wl_scan(void)
+{
+	wl_step("scan setup");
+	uint32_t *w0 = (uint32_t *)wl_htc_tx_payload(&ce3), *w = w0;
+	*w++ = WMI_SCAN_CHAN_LIST_CMDID;
+	w = wl_tlv(w, TAG_SCAN_CHAN_LIST, 4);
+	*w++ = WL_NCHAN;
+	w = wl_tlv(w, TAG_ARRAY_STRUC, WL_NCHAN * 28);
+	for (unsigned i = 0; i < WL_NCHAN; i++) {
+		uint32_t f = wl_freq(i);
+		w = wl_tlv(w, TAG_CHANNEL, 24);
+		*w++ = f;
+		*w++ = f;                               /* band_center_freq1 */
+		*w++ = 0;
+		*w++ = f < 3000 ? 1u : (0u | 1u << 7);  /* mode 11G / 11A + PASSIVE */
+		*w++ = 40u << 8 | 40u << 16;            /* min 0, max 20 dBm, reg 20 dBm (0.5 dB units) */
+		*w++ = 40u << 8;                        /* max tx power */
+	}
+	if (!wl_wmi_send(w)) {
+		return false;
+	}
+	w = w0;
+	*w++ = WMI_VDEV_CREATE_CMDID;
+	w = wl_tlv(w, TAG_VDEV_CREATE, 20);
+	*w++ = 0;                                       /* vdev 0 */
+	*w++ = 2;                                       /* STA */
+	*w++ = 0;
+	*w++ = wl_mac[0] | wl_mac[1] << 8 | wl_mac[2] << 16 | (uint32_t)wl_mac[3] << 24;
+	*w++ = wl_mac[4] | wl_mac[5] << 8;
+	if (!wl_wmi_send(w)) {
+		return false;
+	}
+
+	wl_step("scan");
+	w = w0;
+	*w++ = WMI_START_SCAN_CMDID;
+	w = wl_tlv(w, TAG_START_SCAN, 25 * 4);
+	static const uint32_t common[15] = {
+		0xa001, 0xa001, 0, 1,                   /* scan id, requestor, vdev, priority low */
+		0x11f,                                  /* events: started, completed, bss/foreign chan, dequeued, exit */
+		50, 150, 50, 500, 0, 0, 0, 20000, 5,    /* dwell active/passive, rest min/max, ..., max time, probe delay */
+		0x1u | 0x10u | 0x20u,                   /* PASSIVE, CHAN_STAT_EVENT, FILTER_PROBE_REQ (inverted in WMI-TLV) */
+	};
+	for (int i = 0; i < 15; i++) {
+		*w++ = common[i];
+	}
+	*w++ = 0;                                       /* burst duration */
+	*w++ = WL_NCHAN;
+	*w++ = 1;                                       /* bssids: broadcast */
+	*w++ = 0;                                       /* ssids */
+	*w++ = 0;                                       /* ie len */
+	*w++ = 3;                                       /* probes */
+	*w++ = 0; *w++ = 0; *w++ = 0; *w++ = 0;         /* mac addr, mask */
+	w = wl_tlv(w, TAG_ARRAY_UINT32, WL_NCHAN * 4);
+	for (unsigned i = 0; i < WL_NCHAN; i++) {
+		*w++ = wl_freq(i);
+	}
+	w = wl_tlv(w, TAG_ARRAY_FIXED_STRUC, 0);
+	w = wl_tlv(w, TAG_ARRAY_FIXED_STRUC, 8);
+	*w++ = 0xffffffffu;
+	*w++ = 0xffffu;
+	w = wl_tlv(w, TAG_ARRAY_BYTE, 0);
+	if (!wl_wmi_send(w)) {
+		return false;
+	}
+
+	/* Collect beacons until the scan completes (or 20 s). */
+	static uint8_t seen[32][6];
+	static uint32_t hist_id[16], hist_n[16];
+	unsigned nseen = 0, events = 0, nhist = 0, mgmt = 0;
+	bool done = false;
+	for (int t = 0; t < 2000 && !done; t++) {
+		if (wl_htc_poll(10) != wl_wmi_ep || wl_msg_len < 8) {
+			continue;
+		}
+		uint32_t ev = le32(wl_msg) & 0xffffffu;
+		unsigned hi = 0;
+		while (hi < nhist && hist_id[hi] != ev) {
+			hi++;
+		}
+		if (hi == nhist && nhist < 16) {
+			hist_id[nhist++] = ev;
+			printf("SAILFISH WLAN: first event %#x (%u bytes): %08x %08x %08x %08x %08x %08x %08x %08x\n", ev, wl_msg_len,
+			    le32(&wl_msg[4]), le32(&wl_msg[8]), le32(&wl_msg[12]), le32(&wl_msg[16]), le32(&wl_msg[20]),
+			    le32(&wl_msg[24]), le32(&wl_msg[28]), le32(&wl_msg[32]));
+		}
+		if (hi < 16) {
+			hist_n[hi]++;
+		}
+		if (ev == WMI_SCAN_EVTID) {
+			uint32_t e = le32(&wl_msg[8]), reason = le32(&wl_msg[12]), f = le32(&wl_msg[16]);
+			if (events++ < 4 || e == 2) {
+				printf("SAILFISH WLAN: scan event %#x reason %u freq %u\n", e, reason, f);
+			}
+			done = e == 2;                  /* COMPLETED */
+		} else if (ev == WMI_MGMT_RX_EVTID) {
+			mgmt++;
+			uint32_t hl = le32(&wl_msg[4]) & 0xffff, snr = le32(&wl_msg[12]), ch = le32(&wl_msg[8]);
+			uint32_t fo = 8 + hl + 4;               /* after the header TLV and the byte array's TLV header */
+			if (fo + 36 > wl_msg_len) {
+				continue;
+			}
+			const uint8_t *fr = &wl_msg[fo], *bssid = fr + 16;
+			uint32_t flen = (le32(&wl_msg[fo - 4]) & 0xffff);
+			if ((fr[0] != 0x80 && fr[0] != 0x50) || fo + flen > wl_msg_len) {
+				continue;                       /* beacons and probe responses only */
+			}
+			bool dup = false;
+			for (unsigned i = 0; i < nseen && !dup; i++) {
+				dup = memcmp(seen[i], bssid, 6) == 0;
+			}
+			if (dup || nseen >= 32) {
+				continue;
+			}
+			memcpy(seen[nseen++], bssid, 6);
+			char ssid[33] = "";
+			for (uint32_t o = 36; o + 2 <= flen; o += 2 + fr[o + 1]) {
+				if (fr[o] == 0 && fr[o + 1] <= 32 && o + 2 + fr[o + 1] <= flen) {
+					for (int i = 0; i < fr[o + 1]; i++) {
+						ssid[i] = (fr[o + 2 + i] >= 0x20 && fr[o + 2 + i] < 0x7f) ? (char)fr[o + 2 + i] : '?';
+					}
+					ssid[fr[o + 1]] = 0;
+					break;
+				}
+			}
+			printf("SAILFISH WLAN: BSS %02x:%02x:%02x:%02x:%02x:%02x ch %u snr %u \"%s\"\n", bssid[0], bssid[1],
+			    bssid[2], bssid[3], bssid[4], bssid[5], ch, snr, ssid);
+		}
+	}
+	printf("SAILFISH WLAN: scan %s: %u networks, %u mgmt rx events, %u HTT rx MSDUs\n", done ? "complete" : "TIMEOUT", nseen, mgmt, wl_htt_rx);
+	for (unsigned i = 0; i < nhist; i++) {
+		printf("SAILFISH WLAN: event %#x x %u\n", hist_id[i], hist_n[i]);
+	}
+	sweet_log_kick();
+	return nseen > 0;
 }
 
