+	wr(wl_bar, Q_PCIE_INTR_CLR, WL_PCIE_INTR_MASK);
+	(void)rd(wl_bar, Q_PCIE_INTR_ENABLE);           /* flush the writes before INTA is sampled again */
+	wl_irqs++;
+	wl_kick();
