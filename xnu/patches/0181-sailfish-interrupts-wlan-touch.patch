+/*
+ * Attention as an interrupt: TLMM GPIO 125 level-low into the TLMM summary
+ * interrupt (GIC SPI 208, INTID 240; live DT pinctrl@1010000). INTR_CFG
+ * (+0x8): bit 0 enable, 1 polarity (0 low), 3:2 detection (0 level), 4 raw
+ * status, 7:5 target (3 = apps); INTR_STATUS (+0xc) bit 0, cleared by
+ * writing 0 (Linux pinctrl-msm8996). The handler masks the pin and wakes
+ * the thread, which reads the report and unmasks it.
+ */
+#define TOUCH_IRQ_INTID         240u
+#define TLMM_INTR_CFG           0x8u
+#define TLMM_INTR_STATUS        0xcu
+#define TLMM_INTR_CFG_ON        ((3u << 5) | (1u << 4))        /* apps target, raw status, level low */
+extern bool sweet_spi_attach(uint32_t intid, bool edge, void (*fn)(void *arg), void *arg);
+extern void sweet_spi_mask(uint32_t intid, bool masked);
+static volatile bool touch_irq_on;
+static volatile uint32_t touch_irqs, touch_irq_others;
+
+static void
+touch_irq(__unused void *arg)
+{
+	vm_offset_t g = st.gpio[3];
+	if (touch_rd(g, TLMM_INTR_STATUS) & 1u) {
+		touch_wr(g, TLMM_INTR_CFG, TLMM_INTR_CFG_ON);   /* masked until the thread has read the report */
+		touch_wr(g, TLMM_INTR_STATUS, 0);
+		touch_irqs++;
+		thread_wakeup(&touch_sleep_chan);
+	} else if (++touch_irq_others > 1000) {
+		sweet_spi_mask(TOUCH_IRQ_INTID, true);  /* another pin holds the summary line: back to polling */
+		touch_irq_on = false;
+		thread_wakeup(&touch_sleep_chan);
+	}
+}
+
+/* Unmask the attention interrupt and sleep until it fires (or ms pass). */
+static void
+touch_irq_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	touch_wr(st.gpio[3], TLMM_INTR_CFG, TLMM_INTR_CFG_ON | 1u);    /* after assert_wait: no lost wakeup */
+	thread_block(THREAD_CONTINUE_NULL);
+}
