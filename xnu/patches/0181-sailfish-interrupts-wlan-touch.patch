+{
+	static uint64_t window;
+	static uint32_t in_window;
+	uint64_t now = mach_absolute_time();
+	if (now - window > 19200000ull) {               /* 1 s of the 19.2 MHz timebase */
+		window = now;
+		in_window = 0;
+	}
+	/*
