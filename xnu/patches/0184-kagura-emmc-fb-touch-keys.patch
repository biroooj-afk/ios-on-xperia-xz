+/*
+ * Sony Xperia XZ (kagura) SDHCI eMMC 5.1 Polled Block Backend (SDCC1 @ 0x740000).
+ * Reuses the eMMC host state left in Transfer State by Sony's aboot bootloader.
+ * Uses single-sector PIO transfers (CMD17 / CMD24) for 100% compatibility with
+ * Qualcomm SDCC1 without Auto-CMD12 state machine hangs, and exposes 4 KiB
+ * logical blocks (8 x 512B eMMC sectors) to the rest of sweet_ufs.c.
+ */
+#define SDHCI_DMA_ADDRESS       0x00
+#define SDHCI_BLOCK_SIZE        0x04    /* 16-bit block size + 16-bit block count */
+#define SDHCI_ARGUMENT          0x08
+#define SDHCI_TRANSFER_MODE     0x0c    /* 16-bit xfer mode + 16-bit command */
+#define SDHCI_RESPONSE          0x10
+#define SDHCI_BUFFER            0x20
+#define SDHCI_PRESENT_STATE     0x24
+#define SDHCI_INT_STATUS        0x30
+#define SDHCI_INT_ENABLE        0x34
+#define SDHCI_SIGNAL_ENABLE     0x38
+
+#define SDHCI_CMD_INHIBIT       0x00000001u
+#define SDHCI_DATA_INHIBIT      0x00000002u
+#define SDHCI_SPACE_AVAILABLE   0x00000400u
+#define SDHCI_DATA_AVAILABLE    0x00000800u
+#define SDHCI_INT_RESPONSE      0x00000001u
+#define SDHCI_INT_DATA_END      0x00000002u
+#define SDHCI_INT_SPACE_AVAIL   0x00000010u
+#define SDHCI_INT_DATA_AVAIL    0x00000020u
+#define SDHCI_INT_ERROR_MASK    0x01ff8000u
+
+static int
+sdhci_xfer_sector(uint32_t sec, uint32_t *buf, bool write)
+{
+	for (int t = 0; t < 200000; t++) {
+		if (!(ufs_rd(SDHCI_PRESENT_STATE) & (SDHCI_CMD_INHIBIT | SDHCI_DATA_INHIBIT))) {
+			break;
+		}
+		delay(1);
+	}
+	ufs_wr(SDHCI_SIGNAL_ENABLE, 0);
+	ufs_wr(SDHCI_INT_ENABLE, 0x03ff00ffu);
+	ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+
+	/* Single 512-byte sector PIO: block count = 1, DMA off */
+	ufs_wr(SDHCI_BLOCK_SIZE, (1u << 16) | 512u);
+	ufs_wr(SDHCI_ARGUMENT, sec);
+	uint32_t mode = write ? 0x0000u : (1u << 4);
+	uint32_t cmd = ((write ? 24u : 17u) << 8) | 0x3au;
+	ufs_wr(SDHCI_TRANSFER_MODE, (cmd << 16) | mode);
+
+	for (int t = 0; t < 500000; t++) {
+		uint32_t st = ufs_rd(SDHCI_INT_STATUS);
+		if (st & SDHCI_INT_ERROR_MASK) {
+			ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+			return EIO;
+		}
+		if (st & SDHCI_INT_RESPONSE) {
+			ufs_wr(SDHCI_INT_STATUS, SDHCI_INT_RESPONSE);
+			break;
+		}
+		delay(1);
+	}
+	uint32_t want_mask = write ? SDHCI_SPACE_AVAILABLE : SDHCI_DATA_AVAILABLE;
+	uint32_t int_bit = write ? SDHCI_INT_SPACE_AVAIL : SDHCI_INT_DATA_AVAIL;
+	int t;
+	for (t = 0; t < 500000; t++) {
+		uint32_t st = ufs_rd(SDHCI_INT_STATUS);
+		if (st & SDHCI_INT_ERROR_MASK) {
+			ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+			return EIO;
+		}
+		if ((ufs_rd(SDHCI_PRESENT_STATE) & want_mask) || (st & int_bit)) {
+			ufs_wr(SDHCI_INT_STATUS, int_bit);
+			break;
+		}
+		delay(1);
+	}
+	if (t == 500000) {
+		return ETIMEDOUT;
+	}
+	for (int w = 0; w < 128; w++) {
+		if (write) {
+			ufs_wr(SDHCI_BUFFER, *buf++);
+		} else {
+			*buf++ = ufs_rd(SDHCI_BUFFER);
+		}
+	}
+	for (t = 0; t < 500000; t++) {
+		uint32_t st = ufs_rd(SDHCI_INT_STATUS);
+		if (st & SDHCI_INT_ERROR_MASK) {
+			ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+			return EIO;
+		}
+		if (st & SDHCI_INT_DATA_END) {
+			ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+sdhci_xfer_blocks(uint64_t lba_4k, uint32_t count_4k, bool write)
+{
+	uint64_t sec = lba_4k * 8ull;
+	uint32_t nsec = count_4k * 8u;
+	uint32_t *buf = (uint32_t *)(su.dma + DMA_BOUNCE);
+
+	if (sec + nsec > UINT32_MAX || count_4k == 0 || count_4k > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	for (uint32_t s = 0; s < nsec; s++) {
+		int err = sdhci_xfer_sector((uint32_t)(sec + s), buf + s * 128u, write);
+		if (err != 0) {
+			return err;
+		}
+	}
+	return 0;
+}
