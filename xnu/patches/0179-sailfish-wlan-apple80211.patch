+/*
+ * Apple80211 requests: IO80211.framework (wifid, Settings) sends
+ * SIOCGA80211/SIOCSA80211 {ifname, type, value, len, data} to the
+ * interface, which hands them here (iokit/Kernel/arm/SailfishWLAN.cpp).
+ * iOS 16 layouts (from IO80211.framework's Apple80211GetWithIOCTL): a get
+ * with len 0 returns the value in req_val; SSID is the raw bytes with the
+ * length in req_len; BSSID 6 raw bytes; capabilities a raw bitmap; the
+ * rest {version, ...} as in OpenIntelWireless's apple80211_ioctl.h.
+ * Scan results: one 1164-byte record per SCAN_RESULT get (the macOS 12+
+ * apple80211_scan_result with inline IEs), EIO after the last. A join
+ * (ASSOCIATE, 592 bytes) carries the SSID, maybe a BSSID, and the
+ * passphrase as typed (cipher 10) or the PMK (cipher 6); its outcome is
+ * event ASSOC_DONE plus ASSOCIATE_RESULT. Layouts and conventions checked
+ * against HackiOS (github.com/oosexgang/hackios-xnu-kernel,
+ * bsd/dev/redwood_apple80211.c, APSL 2.0), which answers the same
+ * requests for iOS 16.5. Unknown types: logged (with the caller's
+ * length), EOPNOTSUPP.
+ */
+#define A80211_SSID             1
+#define A80211_CHANNEL          4
+#define A80211_POWERSAVE        5
+#define A80211_BSSID            9
+#define A80211_SCAN_REQ         10
+#define A80211_SCAN_RESULT      11
+#define A80211_CAPS             12
+#define A80211_STATE            13
+#define A80211_PHY_MODE         14
+#define A80211_OP_MODE          15
+#define A80211_RSSI             16
+#define A80211_NOISE            17
+#define A80211_POWER            19
+#define A80211_ASSOCIATE        20
+#define A80211_ASSOCIATE_RESULT 21
+#define A80211_DISASSOCIATE     22
+#define A80211_AUTH_TYPE        2
+#define A80211_HARDWARE_VERSION 44
+#define A80211_SUP_CHANNELS     27
+#define A80211_DRIVER_VERSION   43
+#define A80211_SCAN_REQ_MULTI   86
+#define A80211_CURRENT_NETWORK  103
+#define A80211_HW_CHANNELS      254
+#define A80211_ASR_LEN          0x48c
+#define WL_NOISE_DBM            (-95)
+
+int sailfish_wlan_a80211(int set, uint32_t type, int32_t *val, user_addr_t data, uint32_t *len);
+
+/* Channel {version, number, flags (20 MHz, band, active scan on 2.4 GHz)} at w. */
+static void
+wl_a80211_chan(uint32_t *w, uint32_t ch)
+{
+	w[0] = 1;
+	w[1] = ch;
+	w[2] = 0x2u | (ch <= 14 ? 0x8u | 0x80u : 0x10u);
+}
+
+/* apple80211_scan_result of net into r (A80211_ASR_LEN bytes, zeroed). */
+static void
+wl_a80211_asr(uint8_t *r, const struct wl_net *net)
+{
+	int16_t rssi = (int16_t)((int)net->snr + WL_NOISE_DBM), noise = WL_NOISE_DBM, snr = (int16_t)net->snr;
+	r[0] = 1;
+	wl_a80211_chan((uint32_t *)(r + 4), net->ch);
+	memcpy(r + 0x12, &noise, 2);
+	memcpy(r + 0x14, &snr, 2);
+	memcpy(r + 0x16, &rssi, 2);
+	memcpy(r + 0x18, &net->bint, 2);
+	memcpy(r + 0x1a, &net->cap, 2);
+	memcpy(r + 0x1c, net->bssid, 6);
+	r[0x60] = net->ssid_len;
+	memcpy(r + 0x61, net->ssid, net->ssid_len);
+	/* rates (Mbit/s) from the supported / extended rates elements */
+	for (uint32_t o = 0; o + 2 <= net->ie_len && o + 2u + net->ie[o + 1] <= net->ie_len; o += 2u + net->ie[o + 1]) {
+		for (uint32_t i = 0; (net->ie[o] == 1 || net->ie[o] == 50) && i < net->ie[o + 1] && r[0x22] < 15; i++) {
+			uint32_t mbps = (net->ie[o + 2 + i] & 0x7fu) / 2;
+			if (mbps) {
+				memcpy(r + 0x24 + 4 * r[0x22]++, &mbps, 4);
+			}
+		}
+	}
+	memcpy(r + 0x8a, &net->ie_len, 2);
+	memcpy(r + 0x8c, net->ie, net->ie_len);
+}
+
+int
+sailfish_wlan_a80211(int set, uint32_t type, int32_t *val, user_addr_t data, uint32_t *len)
+{
+	static uint8_t seen[2][512];
+	static uint8_t r[A80211_ASR_LEN];
+	static uint32_t w[2 + 3 * 128];
+	uint8_t *b = (uint8_t *)w;
+	uint32_t n = 0;
+	int err = EOPNOTSUPP;
+	bool up = wl_net_up;
+	bzero(w, sizeof(w));
+	w[0] = 1;                                       /* version */
+	if (set) {
+		switch (type) {
+		case A80211_SCAN_REQ:
+		case A80211_SCAN_REQ_MULTI:
+			err = wl_ready && wl_power ? 0 : EBUSY; /* EBUSY: the framework tries again */
+			wl_scan_req = !err;             /* wl_run scans, then posts SCAN_DONE */
+			break;
+		case A80211_ASSOCIATE: {                /* {version, mode, auth, ssid len @12, ssid @16, bssid @48, key len @60, cipher @64, key @72} */
+			static uint8_t a[0x88];
+			uint32_t sl, kl, kc;
+			if (*len < sizeof(a) || (err = copyin(data, a, sizeof(a))) != 0) {
+				err = err ? err : EINVAL;
+				break;
+			}
+			memcpy(&sl, a + 12, 4);
+			memcpy(&kl, a + 60, 4);
+			memcpy(&kc, a + 64, 4);
+			printf("SAILFISH 80211: join: name of %u bytes, %s BSSID, key of %u bytes, cipher %u\n", sl,
+			    (a[48] | a[49] | a[50] | a[51] | a[52] | a[53]) ? "a given" : "any", kl, kc);
+			err = EINVAL;
+			if (sl && sl <= 32 && ((kc == 10 && kl >= 8 && kl <= 63) || (kc == 6 && kl == 32)) && wl_ready) {
+				lck_mtx_lock(wl_ifq_lock);
+				bzero(&wl_req.ssid, sizeof(wl_req.ssid));
+				wl_req.join = true;
+				wl_req.ssid_len = (uint8_t)sl;
+				memcpy(wl_req.ssid, a + 16, sl);
+				memcpy(wl_req.bssid, a + 48, 6);
+				wl_req.have_pmk = kc == 6;
+				wl_req.pass_len = kc == 10 ? (uint8_t)kl : 0;
+				memcpy(kc == 6 ? wl_req.pmk : wl_req.pass, a + 72, kl);
+				lck_mtx_unlock(wl_ifq_lock);
+				wl_join_result = 0;
+				err = 0;
+			}
+			bzero(a, sizeof(a));
+			break;
+		}
+		case A80211_DISASSOCIATE:
+			lck_mtx_lock(wl_ifq_lock);
+			wl_req.leave = true;
+			lck_mtx_unlock(wl_ifq_lock);
+			err = 0;
+			break;
+		case A80211_POWER:                      /* {version, radios, state[4]} */
+			if (*len < 24 || (err = copyin(data, w, 24)) != 0) {
+				err = err ? err : EINVAL;
+				break;
+			}
+			lck_mtx_lock(wl_ifq_lock);
+			wl_req.power_set = true;
+			wl_req.power_on = w[2] != 0;
+			lck_mtx_unlock(wl_ifq_lock);
+			printf("SAILFISH 80211: power %s\n", w[2] ? "on" : "off");
+			err = 0;
+			break;
+		}
+	} else {
+		switch (type) {
+		case A80211_SSID:                       /* raw bytes, length in req_len */
+			if (up) {
+				n = (uint32_t)strlen(wl_ssid);
+				memcpy(b, wl_ssid, n);
+				*len = n < *len ? n : *len;
+			}
+			err = up ? 0 : ENXIO;
+			break;
+		case A80211_BSSID:                      /* 6 raw bytes */
+			memcpy(b, wl_bss.bssid, 6);
+			n = up ? 6 : 0;
+			err = up ? 0 : ENXIO;
+			break;
+		case A80211_CHANNEL:                    /* {version, channel} */
+			wl_a80211_chan(&w[1], wl_bss.ch);
+			n = up ? 16 : 0;
+			err = up ? 0 : ENXIO;
+			break;
+		case A80211_CAPS: {                     /* raw bitmap (APPLE80211_CAP_*); without WPA2 no WPA2 join is built */
+			static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };   /* AES, AES-CCM, PM, short slot/preamble, WPA2, WME, SGI20 */
+			for (unsigned i = 0; i < sizeof(has); i++) {
+				b[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+			}
+			n = 13;
+			break;
+		}
+		case A80211_STATE:                      /* value: RUN (4) associated, AUTH (2) joining, else INIT */
+			*val = up ? 4 : wl_joining ? 2 : 0;
+			err = 0;
+			break;
+		case A80211_ASSOCIATE_RESULT:           /* value: the last join's outcome (0 while it runs) */
+			*val = (int32_t)wl_join_result;
+			err = 0;
+			break;
+		case A80211_AUTH_TYPE:                  /* {version, lower (open), upper (WPA2-PSK), extended} */
+			w[1] = 1;
+			w[2] = 8;
+			n = up ? 16 : 0;
+			err = up ? 0 : ENXIO;
+			break;
+		case A80211_OP_MODE:                    /* value: station */
+			*val = 1;
+			err = 0;
+			break;
+		case A80211_POWERSAVE:                  /* value: off */
+			*val = 0;
+			err = 0;
+			break;
+		case A80211_PHY_MODE:                   /* {version, supported (11a/b/g), active} */
+			w[1] = 0x2u | 0x4u | 0x8u;
+			w[2] = up ? (wl_bss.ch <= 14 ? 0x8u : 0x2u) : 0;
+			n = 12;
+			break;
+		case A80211_RSSI:                       /* {version, radios, unit (dBm), rssi[4], aggregate, ext[4], aggregate} */
+		case A80211_NOISE:
+			w[1] = 1;
+			w[3] = w[7] = w[8] = w[12] = (uint32_t)(type == A80211_NOISE ? WL_NOISE_DBM : (int)wl_bss.snr + WL_NOISE_DBM);
+			n = up ? 13 * 4 : 0;
+			err = up ? 0 : ENXIO;
+			break;
+		case A80211_POWER:                      /* {version, radios, state[4]} */
+			w[1] = 1;
+			w[2] = wl_power;
+			n = 6 * 4;
+			break;
+		case A80211_SUP_CHANNELS:               /* {version, count, channel[]}: what wl_scan covers */
+		case A80211_HW_CHANNELS:
+			w[1] = WL_NCHAN;
+			for (unsigned i = 0; i < WL_NCHAN; i++) {
+				uint32_t f = wl_freq(i);
+				wl_a80211_chan(&w[2 + 3 * i], f < 3000 ? (f - 2407) / 5 : (f - 5000) / 5);
+			}
+			n = 8 + 12 * WL_NCHAN;
+			break;
+		case A80211_DRIVER_VERSION:             /* the text alone, 256 bytes */
+		case A80211_HARDWARE_VERSION:
+			bzero(b, 256);
+			strlcpy((char *)b, type == A80211_DRIVER_VERSION ? "sailfish: QCA6174 (bsd/dev/sailfish_wlan.c)" : "QCA6174", 256);
+			n = 256;
+			break;
+		case A80211_SCAN_RESULT:                /* next record of the last scan, EIO after the last */
+		case A80211_CURRENT_NETWORK:            /* the joined BSS as a scan record */
+			err = type == A80211_SCAN_RESULT ? EIO : ENXIO;
+			for (uint32_t i = type == A80211_SCAN_RESULT ? wl_scan_next : 0; i < wl_nnets; i++) {
+				if (type == A80211_CURRENT_NETWORK && (!up || memcmp(wl_nets[i].bssid, wl_bss.bssid, 6) != 0)) {
+					continue;
+				}
+				bzero(r, sizeof(r));
+				wl_a80211_asr(r, &wl_nets[i]);
+				if (type == A80211_SCAN_RESULT) {
+					wl_scan_next = i + 1;
+				}
+				err = copyout(r, data, *len < sizeof(r) ? *len : sizeof(r));
+				break;
+			}
+			break;
+		}
+	}
+	if (n) {
+		err = copyout(w, data, n < *len ? n : *len);
+	}
+	if (seen[set ? 1 : 0][type & 0x1ff] < 2 && type != A80211_SCAN_RESULT) {
+		seen[set ? 1 : 0][type & 0x1ff]++;
+		printf("SAILFISH 80211: %s %u val %d len %u -> %d\n", set ? "set" : "get", type, *val, *len, err);
+	}
+	return err;
+}
+
 /* Extended capability id in config space at base (DBI for the RC, conf for the chip); 0 if absent. */
