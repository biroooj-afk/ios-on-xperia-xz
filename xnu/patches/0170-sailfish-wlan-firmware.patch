+		for (int i = 0; i < 60; i += 6) {
+			printf("SAILFISH WLAN: crash[%02d] %08x %08x %08x %08x %08x %08x\n", i, w[i], w[i + 1], w[i + 2],
+			    w[i + 3], w[i + 4], w[i + 5]);
+		}
+		sweet_log_kick();
+	}
+	return n != 0;
+}
